datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Role {
  LEADER
  MEMBER
  OBSERVER
}

enum ProjectRole {
  MANAGER
  LEADER
  MEMBER
  VIEWER
}

enum ProjectInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ProjectStatus {
  ACTIVE
  ON_TRACK
  AT_RISK
  COMPLETED
  ARCHIVED
}

enum TaskEffortMode {
  SHARED
  PARALLEL
}

enum TaskRiskLevel {
  ON_TRACK
  APPROACHING_DEADLINE
  AT_RISK
  OVERDUE
  CRITICAL_SLA
}

enum TaskAcceptanceStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum BlockerCategory {
  TECHNICAL_DEPENDENCY
  AWAITING_REVIEW
  SCOPE_AMBIGUITY
  RESOURCE_BOTTLENECK
  EXTERNAL_BLOCKER
}

enum DefectCategory {
  UNMET_DOD
  BUG
  REQUIREMENT_CHANGE
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  password         String   @default("password123")
  avatarUrl        String?
  secondaryEmail   String?
  primaryPhone     String?
  secondaryPhone   String?
  emergencyContact String?
  telegram         String?
  whatsapp         String?
  github           String?
  bloodGroup       String?
  designation      String?
  bio              String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  isVerified       Boolean   @default(false)
  verificationCode String?
  resetCode        String?
  resetCodeExpires DateTime?

  // Relations
  teamMemberships   UserTeam[]
  createdTasks      Task[]             @relation("CreatedBy")
  assignedTasks     Task[]             @relation("AssignedTo")
  comments          Comment[]
  activities        TaskActivity[]
  notifications     Notification[]
  knowledgeArticles KnowledgeArticle[]
  bookmarks         Bookmark[]
  pushSubscriptions PushSubscription[]

  // Project Module Relations
  managedProjects          Project[]             @relation("ProjectManager")
  projectMemberships       ProjectMember[]
  createdProjectTasks      ProjectTask[]         @relation("ProjectTaskCreatedBy")
  reviewedProjectTasks     ProjectTask[]         @relation("ProjectTaskReviewer")
  assignedProjectTasks     ProjectTaskAssignee[]
  assignedProjectSubtasks  ProjectSubtask[]      @relation("ProjectSubtaskAssignee")
  reviewedProjectSubtasks  ProjectSubtask[]      @relation("ProjectSubtaskReviewer")
  projectIncidents         ProjectIncident[]     @relation("ProjectIncidentAssignee")
  resolvedProjectIncidents ProjectIncident[]     @relation("ProjectIncidentResolver")
  projectReworkLogs        ProjectReworkLog[]
  projectTaskComments      ProjectTaskComment[]
  projectTaskActivities    ProjectTaskActivity[]
  sentProjectInvitations   ProjectInvitation[]   @relation("SentProjectInvitations")
  receivedProjectInvitations ProjectInvitation[] @relation("ReceivedProjectInvitations")
}

model Team {
  id        String   @id @default(uuid())
  name      String
  emoji     String   @default("🧑‍💻")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members           UserTeam[]
  tasks             Task[]
  columns           TaskColumn[]
  knowledgeArticles KnowledgeArticle[]
  bookmarks         Bookmark[]
  notifications     Notification[]
  projects          Project[]
  folders           Folder[]
}

model UserTeam {
  id        String   @id @default(uuid())
  userId    String
  teamId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([teamId, role])
}

model TaskColumn {
  id                   String   @id @default(uuid())
  teamId               String
  name                 String
  order                Int
  wipLimit             Int?
  isComplete           Boolean  @default(false)
  triggersCarryForward Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  team  Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([teamId, name])
  @@index([teamId, order])
}

model Task {
  id            String    @id @default(uuid())
  teamId        String
  title         String
  description   String?
  columnId      String
  priority      String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate       DateTime?
  date          DateTime // The date this task belongs to (for the calendar view)
  originalDate  DateTime // The date this task was originally scheduled for
  carryCount    Int       @default(0) // How many days it has been carried forward
  estimatedTime Float? // in hours
  actualTime    Float? // in hours
  createdById   String
  assignedToId  String
  parentTaskId  String? // For subtasks hierarchy (optional, we also have Checklist)
  isRecurring   Boolean   @default(false)
  recurrence    String? // DAILY, WEEKLY, MONTHLY
  isSoftDeleted Boolean   @default(false)
  isArchived    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  column     TaskColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo User       @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: Cascade)
  parentTask Task?      @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subTasks   Task[]     @relation("SubTasks")

  checklist   ChecklistItem[]
  comments    Comment[]
  attachments Attachment[]
  activities  TaskActivity[]

  @@index([teamId, date, isSoftDeleted, isArchived])
  @@index([teamId, isSoftDeleted, isArchived, date])
  @@index([teamId, assignedToId, date, isSoftDeleted, isArchived])
  @@index([teamId, createdById, date, isSoftDeleted, isArchived])
  @@index([columnId, isSoftDeleted, date])
  @@index([createdById])
  @@index([assignedToId, isSoftDeleted, isArchived])
  @@index([originalDate])
  @@index([parentTaskId])
  @@index([teamId, isRecurring, isSoftDeleted])
}

model ChecklistItem {
  id          String   @id @default(uuid())
  taskId      String
  title       String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, isCompleted])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, createdAt])
  @@index([userId])
}

model Attachment {
  id        String   @id @default(uuid())
  taskId    String
  name      String
  url       String
  type      String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskActivity {
  id         String   @id @default(uuid())
  taskId     String
  userId     String
  actionType String // CREATE, EDIT, STATUS_CHANGE, COMMENT, ATTACHMENT, DELETE
  details    String // JSON string of changes
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([userId])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  content    String
  isRead     Boolean   @default(false)
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  type       String // STALE_ALERT, COMMENT_MENTION, REASSIGN, NEED_ATTENTION
  taskId     String?
  teamId     String?
  createdAt  DateTime  @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([userId, isArchived, createdAt])
  @@index([teamId])
  @@index([taskId])
}

model KnowledgeArticle {
  id          String   @id @default(uuid())
  teamId      String
  title       String
  content     String   @default("")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([createdById])
}

model Bookmark {
  id          String   @id @default(uuid())
  teamId      String
  title       String
  url         String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([createdById])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ==========================================
// PROJECT MODULE MODELS
// ==========================================

model Folder {
  id        String    @id @default(uuid())
  teamId    String
  name      String
  emoji     String    @default("📁")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@index([teamId])
}

model Project {
  id          String        @id @default(uuid())
  teamId      String
  folderId    String?
  title       String
  description String?
  emoji       String        @default("📁")
  startDate   DateTime
  endDate     DateTime
  status      ProjectStatus @default(ACTIVE)
  progress    Float         @default(0) // Percentage 0 - 100
  managerId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  team         Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  folder       Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  manager      User              @relation("ProjectManager", fields: [managerId], references: [id], onDelete: Cascade)
  members      ProjectMember[]
  columns      ProjectColumn[]
  tasks        ProjectTask[]
  dependencies TaskDependency[]
  incidents    ProjectIncident[]
  invitations  ProjectInvitation[]

  @@index([teamId])
  @@index([folderId])
  @@index([managerId])
  @@index([status])
}

model ProjectMember {
  id              String      @id @default(uuid())
  projectId       String
  userId          String
  role            ProjectRole @default(MEMBER)
  isPrimaryLeader Boolean     @default(false)
  dailyCapacity   Float       @default(1.0) // 1.0 = 1 full working day / day
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([projectId, role])
}

model ProjectInvitation {
  id            String                  @id @default(uuid())
  projectId     String
  senderId      String
  receiverId    String
  role          ProjectRole             @default(MEMBER)
  dailyCapacity Float                   @default(1.0)
  status        ProjectInvitationStatus @default(PENDING)
  respondedAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender   User    @relation("SentProjectInvitations", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User    @relation("ReceivedProjectInvitations", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([senderId])
  @@index([receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@index([projectId, receiverId])
}

model ProjectColumn {
  id         String   @id @default(uuid())
  projectId  String
  name       String
  order      Int
  isComplete Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   ProjectTask[]

  @@unique([projectId, name])
  @@index([projectId, order])
}

model ProjectTask {
  id              String           @id @default(uuid())
  projectId       String
  columnId        String
  title           String
  description     String?
  startDate       DateTime
  dueDate         DateTime
  estimatedDays   Float            @default(1.0)
  actualDays      Float            @default(0)
  effortMode      TaskEffortMode   @default(SHARED)
  priority        String           @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  riskLevel       TaskRiskLevel    @default(ON_TRACK)
  blockerCategory BlockerCategory?
  blockerReason   String?
  reworkCount     Int              @default(0)
  reopenCount     Int              @default(0)
  reviewerId      String?
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column          ProjectColumn         @relation(fields: [columnId], references: [id], onDelete: Cascade)
  createdBy       User                  @relation("ProjectTaskCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  reviewer        User?                 @relation("ProjectTaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  assignees       ProjectTaskAssignee[]
  subtasks        ProjectSubtask[]
  successorDeps   TaskDependency[]      @relation("PredecessorTasks")
  predecessorDeps TaskDependency[]      @relation("SuccessorTasks")
  reworkLogs      ProjectReworkLog[]
  incidents       ProjectIncident[]
  comments        ProjectTaskComment[]
  activities      ProjectTaskActivity[]

  @@index([projectId])
  @@index([columnId])
  @@index([createdById])
  @@index([riskLevel])
  @@index([dueDate])
  @@index([projectId, columnId])
  @@index([projectId, riskLevel])
  @@index([projectId, dueDate])
  @@index([reviewerId])
}

model ProjectTaskAssignee {
  id               String               @id @default(uuid())
  taskId           String
  userId           String
  acceptanceStatus TaskAcceptanceStatus @default(ACCEPTED)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model ProjectSubtask {
  id               String               @id @default(uuid())
  parentTaskId     String
  title            String
  description      String?
  assignedToId     String
  startDate        DateTime
  dueDate          DateTime
  estimatedDays    Float                @default(1.0)
  actualDays       Float                @default(0)
  isCompleted      Boolean              @default(false)
  acceptanceStatus TaskAcceptanceStatus @default(ACCEPTED)
  reviewerId       String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  parentTask ProjectTask @relation(fields: [parentTaskId], references: [id], onDelete: Cascade)
  assignedTo User        @relation("ProjectSubtaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  reviewer   User?       @relation("ProjectSubtaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([parentTaskId])
  @@index([assignedToId])
  @@index([isCompleted])
  @@index([parentTaskId, isCompleted])
  @@index([assignedToId, isCompleted])
}

model TaskDependency {
  id                String         @id @default(uuid())
  projectId         String
  predecessorTaskId String
  successorTaskId   String
  dependencyType    DependencyType @default(FINISH_TO_START)
  createdAt         DateTime       @default(now())

  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessorTask ProjectTask @relation("PredecessorTasks", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  successorTask   ProjectTask @relation("SuccessorTasks", fields: [successorTaskId], references: [id], onDelete: Cascade)

  @@unique([predecessorTaskId, successorTaskId])
  @@index([projectId])
  @@index([predecessorTaskId])
  @@index([successorTaskId])
}

model ProjectIncident {
  id              String    @id @default(uuid())
  projectId       String
  taskId          String
  assigneeId      String
  daysLate        Int       @default(0)
  escalationLevel String    @default("LEVEL_1") // LEVEL_1, LEVEL_2
  leaderInaction  Boolean   @default(false)
  resolvedAt      DateTime?
  resolvedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee   User        @relation("ProjectIncidentAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  resolvedBy User?       @relation("ProjectIncidentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([taskId])
  @@index([assigneeId])
  @@index([taskId, resolvedAt])
  @@index([projectId, escalationLevel, resolvedAt])
}

model ProjectReworkLog {
  id             String         @id @default(uuid())
  taskId         String
  cycleNumber    Int
  defectCategory DefectCategory
  reason         String?
  rejectedById   String
  createdAt      DateTime       @default(now())

  task       ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  rejectedBy User        @relation(fields: [rejectedById], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([rejectedById])
}

model ProjectTaskComment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

model ProjectTaskActivity {
  id         String   @id @default(uuid())
  taskId     String
  userId     String
  actionType String // CREATE, EDIT, STATUS_CHANGE, COMMENT, ASSIGN, REWORK
  details    String // JSON string
  createdAt  DateTime @default(now())

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}
